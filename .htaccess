Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^user/([a-zA-Z0-9_-]{3,40})/?$ user.php?handle=$1 [L,QSA]
    RewriteRule ^(?:storage|includes)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "(^\.|\.(?:sqlite|sqlite-wal|sqlite-shm|db|bin|part|lock|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
